{
  "name": "multi-tenant-saas-backend",
  "version": "1.0.0",
  "description": "Backend for multi-tenant SaaS project and task management system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/migrations/run.js",
    "migrate:up": "node src/migrations/up.js",
    "migrate:down": "node src/migrations/down.js",
    "migrate:reset": "node src/migrations/reset.js",
    "seed": "node src/seeds/seed.js"
  },
  "keywords": [
    "saas",
    "multi-tenant",
    "project-management",
    "task-management"
  ],
  "author": "Pavani Vattikolla",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.10.0",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "express-validator": "^7.0.0",
    "uuid": "^9.0.0",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
